rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function profile(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function edge(uid, other) { return /databases/$(database)/documents/members/$(uid)/connections/$(other); }
    function invite(id) { return /databases/$(database)/documents/invitations/$(id); }
    function validPhoto(value) { return value is string && (value == '' || (value.size() <= 60000 && value.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))); }
    function validProfile(d, uid) {
      return d.keys().hasAll(['uid','name','bio','color','createdAt','updatedAt','lastInviteAt'])
        && d.keys().hasOnly(['uid','name','bio','color','createdAt','updatedAt','lastInviteAt','photoData'])
        && d.uid == uid && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.bio is string && d.bio.size() <= 240
        && validPhoto(d.get('photoData', '')) && d.color in ['blue','violet','teal','rose']
        && d.createdAt is timestamp && d.updatedAt == request.time && d.lastInviteAt is timestamp;
    }
    match /profiles/{uid} {
      allow get: if verified() && (request.auth.uid == uid || exists(edge(request.auth.uid, uid)));
      allow list: if false;
      allow create: if verified() && request.auth.uid == uid && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastInviteAt == timestamp.value(0);
      allow update: if verified() && request.auth.uid == uid && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.lastInviteAt == resource.data.lastInviteAt || request.resource.data.lastInviteAt == request.time);
      allow delete: if false;
    }
    match /invitations/{id} {
      function recipient() { return resource.data.recipientEmail == request.auth.token.email.lower(); }
      function pending() { return resource.data.status == 'pending' && resource.data.expiresAt > request.time; }
      allow read: if verified() && (resource.data.senderUid == request.auth.uid || recipient());
      allow create: if verified() && id.size() == 20
        && request.resource.data.keys().hasOnly(['senderUid','senderName','recipientEmail','recipientUid','relationship','status','createdAt','updatedAt','expiresAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderName == get(profile(request.auth.uid)).data.name
        && request.resource.data.recipientEmail is string && request.resource.data.recipientEmail.size() <= 254
        && request.resource.data.recipientEmail.matches('[^@ ]+@[^@ ]+\\.[^@ ]+')
        && request.resource.data.recipientEmail == request.resource.data.recipientEmail.lower()
        && request.resource.data.recipientEmail != request.auth.token.email.lower()
        && request.resource.data.recipientUid == ''
        && request.resource.data.relationship in ['Friend','Family','Colleague','Other']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
        && get(profile(request.auth.uid)).data.lastInviteAt < request.time - duration.value(30, 's')
        && getAfter(profile(request.auth.uid)).data.lastInviteAt == request.time;
      allow update: if verified() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','recipientUid','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.senderUid == request.auth.uid && request.resource.data.status == 'cancelled'
            && request.resource.data.recipientUid == resource.data.recipientUid)
          || (recipient() && request.resource.data.status == 'declined'
            && request.resource.data.recipientUid == resource.data.recipientUid)
          || (recipient() && pending() && resource.data.senderUid != request.auth.uid
            && request.resource.data.status == 'accepted' && request.resource.data.recipientUid == request.auth.uid
            && exists(profile(request.auth.uid))
            && getAfter(edge(resource.data.senderUid, request.auth.uid)).data.invitationId == id
            && getAfter(edge(request.auth.uid, resource.data.senderUid)).data.invitationId == id)
        );
      allow delete: if false;
    }
    match /members/{uid}/connections/{other} {
      allow read: if verified() && request.auth.uid == uid;
      allow create: if verified() && request.auth.uid in [uid, other] && uid != other
        && request.resource.data.keys().hasOnly(['otherUid','invitationId','relationship','createdAt'])
        && request.resource.data.otherUid == other
        && request.resource.data.createdAt == request.time
        && get(invite(request.resource.data.invitationId)).data.status == 'pending'
        && get(invite(request.resource.data.invitationId)).data.expiresAt > request.time
        && getAfter(invite(request.resource.data.invitationId)).data.status == 'accepted'
        && getAfter(invite(request.resource.data.invitationId)).data.recipientUid == request.auth.uid
        && getAfter(invite(request.resource.data.invitationId)).data.senderUid in [uid, other]
        && getAfter(invite(request.resource.data.invitationId)).data.recipientUid in [uid, other]
        && request.resource.data.relationship == getAfter(invite(request.resource.data.invitationId)).data.relationship
        && getAfter(edge(other, uid)).data.invitationId == request.resource.data.invitationId;
      allow delete: if verified() && request.auth.uid in [uid, other] && !existsAfter(edge(other, uid));
      allow update: if false;
    }
    match /pets/{id} {
      function validPet(d) {
        return d.keys().hasOnly(['ownerUid','name','species','bio','photoData','createdAt','updatedAt'])
          && d.ownerUid is string && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
          && d.species in ['Dog','Cat','Bird','Horse','Other'] && d.bio is string && d.bio.size() <= 240
          && validPhoto(d.photoData) && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      allow read: if verified() && (resource.data.ownerUid == request.auth.uid || exists(edge(request.auth.uid, resource.data.ownerUid)));
      allow create: if verified() && id.size() == 20 && validPet(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid && exists(profile(request.auth.uid))
        && request.resource.data.createdAt == request.time;
      allow update: if verified() && resource.data.ownerUid == request.auth.uid && validPet(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if verified() && resource.data.ownerUid == request.auth.uid;
    }
    function circle(id) { return /databases/$(database)/documents/circles/$(id); }
    function circleInvite(id, uid) { return /databases/$(database)/documents/circleInvitations/$(id + '_' + uid); }
    match /circles/{id} {
      function validCircle(d) {
        return d.keys().hasOnly(['ownerUid','title','description','memberUids','memberNames','createdAt','updatedAt'])
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 60
          && d.description is string && d.description.size() <= 240
          && d.memberUids is list && d.memberUids.size() >= 1 && d.memberUids.size() <= 20
          && d.memberUids.toSet().size() == d.memberUids.size() && d.ownerUid in d.memberUids
          && d.memberNames is map && d.memberNames.size() == d.memberUids.size()
          && d.memberNames.keys().hasAll(d.memberUids)
          && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      function stableMetadata() {
        return request.resource.data.title == resource.data.title && request.resource.data.description == resource.data.description;
      }
      function joining() {
        let uid = request.auth.uid;
        let before = get(circleInvite(id, uid)).data;
        return !(uid in resource.data.memberUids) && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && uid in request.resource.data.memberUids && stableMetadata()
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([uid])
          && request.resource.data.memberNames[uid] == get(profile(uid)).data.name
          && before.status == 'pending' && before.expiresAt > request.time && before.ownerUid == resource.data.ownerUid
          && exists(edge(resource.data.ownerUid, uid))
          && getAfter(circleInvite(id, uid)).data.status == 'accepted';
      }
      allow read: if verified() && request.auth.uid in resource.data.memberUids;
      allow create: if verified() && id.size() == 20 && validCircle(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberNames[request.auth.uid] == get(profile(request.auth.uid)).data.name
        && request.resource.data.createdAt == request.time;
      allow update: if verified() && validCircle(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.createdAt == resource.data.createdAt
        && (
          (request.auth.uid == resource.data.ownerUid
            && resource.data.memberUids.hasAll(request.resource.data.memberUids)
            && request.resource.data.memberNames.diff(resource.data.memberNames).addedKeys().size() == 0
            && request.resource.data.memberNames.diff(resource.data.memberNames).changedKeys().size() == 0)
          || (request.auth.uid in resource.data.memberUids && request.auth.uid != resource.data.ownerUid && stableMetadata()
            && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
            && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]))
          || joining()
        );
      allow delete: if verified() && request.auth.uid == resource.data.ownerUid;
    }
    match /circleInvitations/{id} {
      function validCircleInvite(d) {
        return d.keys().hasOnly(['circleId','circleTitle','ownerUid','senderName','recipientUid','status','createdAt','updatedAt','expiresAt'])
          && d.circleId is string && d.circleId.size() == 20 && id == d.circleId + '_' + d.recipientUid
          && d.ownerUid == request.auth.uid && d.ownerUid == get(circle(d.circleId)).data.ownerUid
          && d.circleTitle == get(circle(d.circleId)).data.title
          && d.senderName == get(profile(request.auth.uid)).data.name
          && exists(edge(request.auth.uid, d.recipientUid)) && exists(profile(d.recipientUid))
          && !(d.recipientUid in get(circle(d.circleId)).data.memberUids)
          && d.status == 'pending' && d.createdAt == request.time && d.updatedAt == request.time
          && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(7, 'd')
          && get(profile(request.auth.uid)).data.lastInviteAt < request.time - duration.value(30, 's')
          && getAfter(profile(request.auth.uid)).data.lastInviteAt == request.time;
      }
      allow read: if verified() && (resource.data.ownerUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow create: if verified() && validCircleInvite(request.resource.data);
      allow update: if verified() && (
        (request.auth.uid == resource.data.ownerUid && resource.data.status != 'pending' && validCircleInvite(request.resource.data))
        || (resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (
            (request.auth.uid == resource.data.ownerUid && request.resource.data.status == 'cancelled')
            || (request.auth.uid == resource.data.recipientUid && request.resource.data.status == 'declined')
            || (request.auth.uid == resource.data.recipientUid && request.resource.data.status == 'accepted'
              && resource.data.expiresAt > request.time
              && request.auth.uid in getAfter(circle(resource.data.circleId)).data.memberUids)
          ))
      );
      allow delete: if false;
    }
    match /memories/{id} {
      function validAlbumPhoto(p) { return p is string && p.size() <= 240000 && p.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'); }
      function validAlbum(d) {
        let photos = d.get('additionalPhotos', []);
        return photos is list && photos.size() <= 3 && (photos.size() == 0 || d.photoData != '')
          && (photos.size() < 1 || validAlbumPhoto(photos[0]))
          && (photos.size() < 2 || validAlbumPhoto(photos[1]))
          && (photos.size() < 3 || validAlbumPhoto(photos[2]));
      }
      function validCaption(c) { return c is string && c.size() <= 500; }
      function validCaptions(d) {
        let captions = d.get('photoCaptions', []);
        let count = (d.photoData == '' ? 0 : 1) + d.get('additionalPhotos', []).size();
        return !('photoCaptions' in d) || (captions is list && captions.size() == count && captions.size() <= 4
          && (captions.size() < 1 || validCaption(captions[0]))
          && (captions.size() < 2 || validCaption(captions[1]))
          && (captions.size() < 3 || validCaption(captions[2]))
          && (captions.size() < 4 || validCaption(captions[3])));
      }
      function validMemory(d) {
        return d.keys().hasOnly(['ownerUid','ownerName','title','story','happenedOn','photoData','additionalPhotos','photoCaptions','personUid','petId','circleId','audienceKind','audienceId','createdAt','updatedAt'])
          && d.ownerUid == request.auth.uid && d.ownerName == get(profile(request.auth.uid)).data.name
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
          && d.story is string && d.story.size() <= 4000
          && d.photoData is string && (d.photoData == '' || (d.photoData.size() <= 240000 && d.photoData.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
          && validAlbum(d) && validCaptions(d) && (d.story.size() > 0 || d.photoData.size() > 0)
          && d.happenedOn is string && (d.happenedOn == '' || d.happenedOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          && d.personUid is string && (d.personUid == '' || d.personUid == request.auth.uid || exists(edge(request.auth.uid, d.personUid)))
          && d.petId is string && (d.petId == '' || get(/databases/$(database)/documents/pets/$(d.petId)).data.ownerUid == request.auth.uid)
          && d.circleId is string && (d.circleId == '' || request.auth.uid in get(circle(d.circleId)).data.memberUids)
          && ((d.audienceKind == 'private' && d.audienceId == '')
            || (d.audienceKind == 'person' && d.personUid != '' && d.personUid != request.auth.uid && d.audienceId == d.personUid && exists(edge(request.auth.uid, d.audienceId)))
            || (d.audienceKind == 'circle' && d.circleId != '' && d.audienceId == d.circleId))
          && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      function canReadMemory() {
        return resource.data.ownerUid == request.auth.uid
          || (resource.data.audienceKind == 'person' && resource.data.audienceId == request.auth.uid && exists(edge(request.auth.uid, resource.data.ownerUid)))
          || (resource.data.audienceKind == 'circle' && request.auth.uid in get(circle(resource.data.audienceId)).data.memberUids);
      }
      allow get: if verified() && canReadMemory();
      allow list: if verified() && request.query.limit <= 50 && canReadMemory();
      allow create: if verified() && id.size() == 20 && validMemory(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if verified() && resource.data.ownerUid == request.auth.uid && validMemory(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if verified() && resource.data.ownerUid == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
