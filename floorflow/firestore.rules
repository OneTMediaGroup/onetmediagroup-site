rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function user(p) { return get(/databases/$(database)/documents/plants/$(p)/users/$(request.auth.token.userId)).data; }
  function member(p) {
   return signed() && request.auth.token.get('plantId','') == p
    && request.auth.token.get('sessionExpiresAt',0) > request.time.toMillis()
    && !(user(p).get('status','active') in ['inactive','disabled']) && user(p).get('isActive',true)
    && user(p).get('authVersion',0) == request.auth.token.get('authVersion',-1);
  }
  function role(p, roles) { return member(p) && user(p).role in roles; }
  function plant(p) { return get(/databases/$(database)/documents/plants/$(p)).data; }
  function owner(p) { return signed() && plant(p).get('ownerUid','') == request.auth.uid && !plant(p).get('setupComplete',false); }
  function billing(p) { return plant(p).get('isDemo',false) || (plant(p).get('paid',false) && plant(p).get('productionUnlocked',false) && plant(p).get('subscriptionStatus','') in ['active','trialing']); }
  function setup(p) { return role(p,['admin']) && billing(p) && !plant(p).get('isDemo',false); }
  function samePlant(p) { return request.resource.data.get('plantId',p) == p; }
  function actor(p) { return role(p,['operator','dieSetter','supervisor','admin']) && billing(p); }
  match /plants/{p} {
   allow get: if member(p) || owner(p);
   allow list, write: if false;
   match /users/{u} { allow read: if member(p); allow write: if false; }
   match /credentials/{u} { allow read, write: if false; }
   match /settings/{s} { allow read: if member(p); allow create,update: if setup(p) && samePlant(p); }
   match /areas/{a} { allow read: if member(p) && billing(p); allow create,update: if setup(p) && samePlant(p); allow delete: if setup(p); }
   match /workCells/{c} {
    allow read: if member(p) && billing(p);
    allow create: if setup(p) && samePlant(p);
    allow delete: if setup(p);
    allow update: if samePlant(p) && (setup(p) || (actor(p) && !resource.data.get('isLocked',false)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots','updatedAt','lastUpdatedBy'])
      && request.resource.data.slots is list && request.resource.data.slots.size() == 4
      && request.resource.data.lastUpdatedBy == user(p).name));
   }
   match /partLibrary/{part} { allow read: if member(p) && billing(p); allow create,update: if role(p,['supervisor','admin']) && billing(p) && samePlant(p) && !plant(p).get('isDemo',false); allow delete: if setup(p); }
   match /activityLogs/{l} { allow read: if member(p) && billing(p); allow create: if actor(p) && samePlant(p); allow update,delete: if false; }
   match /archives/{a} { allow read: if role(p,['supervisor','admin']) && billing(p); allow create: if setup(p) && samePlant(p); }
   match /reports/{r} { allow read: if role(p,['supervisor','admin']) && billing(p); allow create: if role(p,['supervisor','admin']) && billing(p) && samePlant(p); }
  }
  match /{document=**} { allow read,write: if false; }
 }
}
