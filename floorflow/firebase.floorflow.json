{
  "functions": [
    {
      "source": "floorflow-functions",
      "codebase": "floorflow-functions",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "functions": {
      "port": 5008
    },
    "auth": {
      "port": 9198
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}